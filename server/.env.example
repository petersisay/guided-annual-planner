# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin for CORS & Session Cookies
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection URI (Local Development or MongoDB Atlas)
# Local: mongodb://localhost:27017/guided_planner
# Atlas: mongodb+srv://<dbuser>:<dbpassword>@<cluster>.mongodb.net/guided_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/guided_planner

# Session Secret (Generate a secure random string with minimum 32 characters)
SESSION_SECRET=dev_secret_key_minimum_32_characters_long_for_hmac_sha256

# Session Cookie Name & Security
COOKIE_NAME=planner_session
COOKIE_SECURE=false

# Google OAuth 2.0 Web Client ID (From Google Cloud Console)
# Note: Google Client Secret is NOT needed for Google ID token verification
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
